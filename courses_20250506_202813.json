    {
      "id": "6630749086666515498",
      "site_id": "656ebd85848d4860aecfaf89d17b29eb",
      "visit_number": 1765,
      "custom_info": null,
      "is_resource_auto_public": false,
      "site_name": "计算机网络",
      "key": 128725,
      "join_type": 1,
      "creator": "5986462294291267488",
      "status": 1,
      "lock": 1,
      "cover_img": "https://aia-publication.oss-cn-shanghai.aliyuncs.com/site-cover-img/13.png",
      "description": "{\"blocks\":[{\"key\":\"75o0l\",\"text\":\"计算机网络课程是计算机学科的专业必修课程，在专业建设和课程体系中占据重要的地位。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"dorvo\",\"text\":\"本课程系统地介绍了计算机网络的发展和体系结构，以及物理层、数据链路层、网络层、运输层、应用层等各层次功能、基本概念、工作原理、典型协议等内容。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"8hadr\",\"text\":\"本课程是一门理论性较强的课程，突出基本原理和基本概念，通过本课程的学习：\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"2v7lp\",\"text\":\"1.对计算机网络从整体上有一个较清晰的认识。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"88arq\",\"text\":\"2.掌握计算机网络的分层架构与原理，各层次功能、概念、原理及层次间相互关系。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"9n0nf\",\"text\":\"3.掌握典型网络协议的工作原理、实现机制及应用场合，理解典型网络设备的工作原理。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"7bt5g\",\"text\":\"4.培养运用计算机网络技术解决问题的能力，为进一步学习基于网络的实际应用奠定坚实的理论基础。\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}",
